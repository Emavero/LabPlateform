# Copier en .env puis adapter. Toutes les valeurs ont un défaut de développement.
FRONTEND_PORT=3000

DB_NAME=labplatform
DB_USERNAME=labplatform
DB_PASSWORD=me

# 32 octets minimum. Exemple : openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_VALIDITY=8h

# Passer à true derrière HTTPS.
APP_COOKIE_SECURE=false

# Affiche le lien de réinitialisation à l'écran (aucun serveur d'e-mail configuré).
# À passer à false dès que APP_MAIL_ENABLED vaut true : sinon le lien part par
# courriel ET reste lisible dans la réponse HTTP, où n'importe qui peut le
# réclamer pour l'adresse d'un autre.
APP_EXPOSE_RESET_TOKEN=true

# --- Envoi des courriels (lien de réinitialisation) ---
# Adresse publique de l'application : c'est elle qui rend le lien cliquable.
# Derrière ngrok ou un nom de domaine, mettre cette adresse-là.
APP_PUBLIC_URL=http://localhost:3000
# Faux : rien n'est contacté, le lien s'affiche à l'écran.
APP_MAIL_ENABLED=false
APP_MAIL_FROM=cyberMans <no-reply@cybermans.local>
# Serveur SMTP. Essai local : docker-compose.mail.yml fournit Mailpit
# (MAIL_HOST=mail, port 1025, sans authentification ni TLS).
# Brevo      : smtp-relay.brevo.com   port 587, auth true, starttls true
# Mailgun    : smtp.mailgun.org       port 587, auth true, starttls true
# Gmail      : smtp.gmail.com         port 587, auth true, starttls true
#              (mot de passe d'application, pas celui du compte)
# Laisser localhost sans serveur d'envoi : docker-compose.mail.yml impose
# « mail » de lui-même quand vous lancez Mailpit.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
# Port de la boîte de réception locale (docker-compose.mail.yml).
MAILPIT_UI_PORT=8025

# Comptes administrateurs, séparés par des virgules. Ils voient le tableau de
# bord d'administration et publient les cours ; le rôle ne s'obtient que par
# cette liste, jamais depuis l'application.
APP_ADMIN_EMAILS=admin@gmail.com

# --- Vidéos de cours téléversées ---
# Taille maximale d'une vidéo. Relever aussi client_max_body_size dans nginx.conf.
APP_MEDIA_MAX_FILE_SIZE=256MB

# --- Catalogue de machines (flags, points, classement) ---
# Écrit les flags du catalogue dans les journaux au premier démarrage : les
# machines étant simulées, il n'y a pas de cible où aller les chercher.
APP_BOXES_LOG_SEEDED_FLAGS=true
# Nombre de joueurs affichés dans le classement.
APP_BOXES_LEADERBOARD_SIZE=20
# Durée de vie d'une cible lancée à la demande par un joueur.
APP_BOXES_INSTANCE_LIFETIME=2h

# --- Machines Linux réelles (docker-compose.docker-lab.yml) ---
# Groupe propriétaire du socket Docker. Linux : stat -c %g /var/run/docker.sock
# Docker Desktop (Windows, macOS) : laisser 0.
DOCKER_GID=0
# Adresse que les utilisateurs tapent dans leur commande ssh (IP ou nom du serveur).
LAB_PUBLIC_HOST=localhost
# 127.0.0.1 = ce poste uniquement ; 0.0.0.0 = accessible depuis le réseau.
LAB_BIND_ADDRESS=127.0.0.1
# Délai laissé à une cible pour démarrer. À relever si vous voyez « La machine
# Linux n'a pas démarré dans le délai prévu » : machine lente, disque chargé,
# ou Docker Desktop.
LAB_READY_TIMEOUT=90s
LAB_MEMORY=512m
LAB_CPUS=1.0

# --- Accès VPN des utilisateurs (page « VPN Access ») ---
# « generated » : la plateforme émet un certificat par apprenant (easy-rsa),
# révocable individuellement. « uploaded » : l'administrateur dépose un .ovpn
# depuis l'écran d'administration, et tous téléchargent le même. docs/VPN.md
APP_VPN_SOURCE=generated
APP_VPN_ENABLED=false
# Adresse publique de la passerelle OpenVPN : IP publique de la box, nom de domaine,
# ou adresse ngrok TCP (ex. 5.tcp.eu.ngrok.io avec son port).
APP_VPN_UDP_HOST=
APP_VPN_UDP_PORT=1194
# Laisser vide pour ne pas proposer TCP. Via ngrok, seul TCP fonctionne.
APP_VPN_TCP_HOST=
APP_VPN_TCP_PORT=1194
# Réseau des machines, routé par le profil .ovpn remis à chaque utilisateur.
# En mode GCP, cette plage doit être celle du sous-réseau VPC de vos instances :
# sinon le tunnel monte et l'adresse interne affichée ne répond pas (docs/GCP.md).
APP_VPN_LAB_NETWORK=10.10.10.0/24

# ── Abonnement Pro ────────────────────────────────────────────────────────────
# Les machines du catalogue sont réservées aux abonnés (sauf celles que
# l'administration ouvre explicitement) ; les cours restent accessibles à tous.
# false ouvre toute la plateforme : à garder pour un lab interne.
APP_BILLING_ENABLED=true
# « simulated » : le parcours d'abonnement se déroule sans prestataire, donc
# tout compte peut s'attribuer un abonnement en cliquant. À ne garder que pour
# essayer. « live » appelle réellement Stripe et Wave avec les clés ci-dessous.
APP_BILLING_MODE=simulated
APP_BILLING_METHODS=CARD,WAVE
# Tarif de base, écrit comme il s'affiche. Le franc CFA n'a pas de centimes.
APP_BILLING_CURRENCY=XOF
APP_BILLING_MONTHLY=5000
APP_BILLING_YEARLY=50000
# Les réseaux bancaires n'acceptent pas le franc CFA : la carte a son tarif.
APP_BILLING_CARD_CURRENCY=EUR
APP_BILLING_CARD_MONTHLY=8.00
APP_BILLING_CARD_YEARLY=80.00
# Adresse publique de l'application, où le payeur est renvoyé.
APP_BILLING_SUCCESS_URL=http://localhost:3000/abonnement/retour
APP_BILLING_CANCEL_URL=http://localhost:3000/abonnement
# Clés des prestataires, nécessaires seulement en mode « live ».
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Machine cible sur Google Compute Engine
#
# « simulated » par défaut : la cible traverse réellement ses états, sans
# projet GCP ni identifiants. Passez à « gcp » pour piloter une vraie instance.
# Marche à suivre complète, rôles IAM compris : docs/GCP.md
# ---------------------------------------------------------------------------
APP_MACHINE_PROVIDER=simulated
# Adresse montrée à l'apprenant. À renseigner quand la cible se joint par une
# adresse de tunnel et non par celle de sa carte réseau — typiquement 10.8.0.1
# si la passerelle VPN et la cible sont la même VM. Vide : celle de l'hébergeur.
APP_MACHINE_ADDRESS=
GCP_PROJECT_ID=
GCP_ZONE=europe-west1-b
GCP_INSTANCE_NAME=target-01
# Au-delà, un démarrage rend la main avec un message plutôt que de bloquer.
GCP_OPERATION_TIMEOUT=60s
# Nom d'instance d'une cible du catalogue, quand APP_HYPERVISOR_MODE=gcp.
GCP_TARGET_NAME=target-{slug}
# Clé du compte de service. À laisser vide si la plateforme tourne sur GCP :
# l'identité attachée à la machine suffit, et une clé qui n'existe pas ne fuit pas.
GOOGLE_APPLICATION_CREDENTIALS=
