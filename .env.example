# Copier en .env puis adapter. Toutes les valeurs ont un défaut de développement.
FRONTEND_PORT=3000

DB_NAME=labplatform
DB_USERNAME=labplatform
DB_PASSWORD=change-me

# 32 octets minimum. Exemple : openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_VALIDITY=8h

# Passer à true derrière HTTPS.
APP_COOKIE_SECURE=false

# Affiche le lien de réinitialisation à l'écran (aucun serveur d'e-mail configuré).
APP_EXPOSE_RESET_TOKEN=true

# Comptes administrateurs, séparés par des virgules. Ils voient le tableau de
# bord d'administration et publient les cours ; le rôle ne s'obtient que par
# cette liste, jamais depuis l'application.
APP_ADMIN_EMAILS=admin@gmail.com

# --- Vidéos de cours téléversées ---
# Taille maximale d'une vidéo. Relever aussi client_max_body_size dans nginx.conf.
APP_MEDIA_MAX_FILE_SIZE=256MB

# --- Catalogue de machines (flags, points, classement) ---
# Écrit les flags du catalogue dans les journaux au premier démarrage : les
# machines étant simulées, il n'y a pas de cible où aller les chercher.
APP_BOXES_LOG_SEEDED_FLAGS=true
# Nombre de joueurs affichés dans le classement.
APP_BOXES_LEADERBOARD_SIZE=20
# Durée de vie d'une cible lancée à la demande par un joueur.
APP_BOXES_INSTANCE_LIFETIME=2h

# --- Machines Linux réelles (docker-compose.docker-lab.yml) ---
# Groupe propriétaire du socket Docker. Linux : stat -c %g /var/run/docker.sock
# Docker Desktop (Windows, macOS) : laisser 0.
DOCKER_GID=0
# Adresse que les utilisateurs tapent dans leur commande ssh (IP ou nom du serveur).
LAB_PUBLIC_HOST=localhost
# 127.0.0.1 = ce poste uniquement ; 0.0.0.0 = accessible depuis le réseau.
LAB_BIND_ADDRESS=127.0.0.1
LAB_MEMORY=512m
LAB_CPUS=1.0

# --- Accès VPN des utilisateurs (page « VPN Access ») ---
APP_VPN_ENABLED=false
# Adresse publique de la passerelle OpenVPN : IP publique de la box, nom de domaine,
# ou adresse ngrok TCP (ex. 5.tcp.eu.ngrok.io avec son port).
APP_VPN_UDP_HOST=
APP_VPN_UDP_PORT=1194
# Laisser vide pour ne pas proposer TCP. Via ngrok, seul TCP fonctionne.
APP_VPN_TCP_HOST=
APP_VPN_TCP_PORT=1194
APP_VPN_LAB_NETWORK=10.10.10.0/24

# ── Abonnement Pro ────────────────────────────────────────────────────────────
# Les machines du catalogue sont réservées aux abonnés (sauf celles que
# l'administration ouvre explicitement) ; les cours restent accessibles à tous.
# false ouvre toute la plateforme : à garder pour un lab interne.
APP_BILLING_ENABLED=true
# « simulated » : le parcours d'abonnement se déroule sans prestataire, donc
# tout compte peut s'attribuer un abonnement en cliquant. À ne garder que pour
# essayer. « live » appelle réellement Stripe et Wave avec les clés ci-dessous.
APP_BILLING_MODE=simulated
APP_BILLING_METHODS=CARD,WAVE
# Tarif de base, écrit comme il s'affiche. Le franc CFA n'a pas de centimes.
APP_BILLING_CURRENCY=XOF
APP_BILLING_MONTHLY=5000
APP_BILLING_YEARLY=50000
# Les réseaux bancaires n'acceptent pas le franc CFA : la carte a son tarif.
APP_BILLING_CARD_CURRENCY=EUR
APP_BILLING_CARD_MONTHLY=8.00
APP_BILLING_CARD_YEARLY=80.00
# Adresse publique de l'application, où le payeur est renvoyé.
APP_BILLING_SUCCESS_URL=http://localhost:3000/abonnement/retour
APP_BILLING_CANCEL_URL=http://localhost:3000/abonnement
# Clés des prestataires, nécessaires seulement en mode « live ».
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
